<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
    xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
    xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
    xsi:type="MailApp">

  <!-- IMPORTANT: Generate your own GUID for Id (e.g. via `[guid]::NewGuid()` in PowerShell).
       Do not reuse this placeholder in production. -->
  <Id>a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Cellular Sales</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="CS Email Signature" />
  <Description DefaultValue="Select and insert your official Cellular Sales email signature template." />
  <IconUrl DefaultValue="https://YOUR-HOSTING-DOMAIN/assets/icon-32.png" />
  <HighResIconUrl DefaultValue="https://YOUR-HOSTING-DOMAIN/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://YOUR-HOSTING-DOMAIN/support" />

  <AppDomains>
    <AppDomain>https://YOUR-HOSTING-DOMAIN</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <!-- 1.10 is required for Body.setSignatureAsync -->
      <Set Name="Mailbox" MinVersion="1.10" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://YOUR-HOSTING-DOMAIN/taskpane/taskpane.html" />
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit" />
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.10">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="functionFile" />

          <!-- Add-in command: a ribbon button that opens the task pane -->
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="csSignatureGroup">
                <Label resid="groupLabel" />
                <Control xsi:type="Button" id="csSignatureButton">
                  <Label resid="buttonLabel" />
                  <Supertip>
                    <Title resid="buttonLabel" />
                    <Description resid="buttonTooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>csSignatureTaskpane</TaskpaneId>
                    <SourceLocation resid="taskpaneUrl" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

          <!-- NOTE: Phase 3 will add a LaunchEvent extension point here (OnNewMessageCompose)
               to auto-prompt users who haven't set a signature yet. Left out of Phase 1
               to keep the MVP simple — for now, users click the ribbon button manually. -->

        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="icon16" DefaultValue="https://YOUR-HOSTING-DOMAIN/assets/icon-16.png" />
        <bt:Image id="icon32" DefaultValue="https://YOUR-HOSTING-DOMAIN/assets/icon-32.png" />
        <bt:Image id="icon80" DefaultValue="https://YOUR-HOSTING-DOMAIN/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="taskpaneUrl" DefaultValue="https://YOUR-HOSTING-DOMAIN/taskpane/taskpane.html" />
        <bt:Url id="functionFile" DefaultValue="https://YOUR-HOSTING-DOMAIN/taskpane/functions.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="groupLabel" DefaultValue="CS Signature" />
        <bt:String id="buttonLabel" DefaultValue="Insert Signature" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="buttonTooltip" DefaultValue="Choose and insert your official Cellular Sales email signature." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
